    {
        "id": "7ef028c8.7bc268",
        "type": "template",
        "z": "41060c49.066e34",
        "name": "Simple Web Page",
        "field": "payload",
        "fieldType": "msg",
        "format": "html",
        "syntax": "mustache",
        "template": "<!DOCTYPE HTML>\n<html>\n    <head>\n    <title>Simple Live Display</title>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css\">\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"/landin_template.css\">\n    <script type=\"text/javascript\">\n        const getCellValue = (tr, idx) => tr.children[0].children[idx].innerText || tr.children[0].children[idx].textContent;\n\n        const comparer = (idx, asc) => (a, b) => ((v1, v2) => \n            v1 !== '' && v2 !== '' && !isNaN(v1) && !isNaN(v2) ? v1 - v2 : v1.toString().localeCompare(v2)\n            )(getCellValue(asc ? a : b, idx), getCellValue(asc ? b : a, idx));\n            \n        function sortTable() {\n            const styleSheet = document.createElement('style')\n            styleSheet.innerHTML = `\n                .order-inactive span {\n                    visibility:hidden;\n                }\n                .order-inactive:hover span {\n                    visibility:visible;\n                }\n                .order-active span {\n                    visibility: visible;\n                }`\n            document.head.appendChild(styleSheet)\n            document.querySelectorAll('th.order').forEach(th => {\n                if (th.querySelector('span') == null) {\n                    const span_elem = document.createElement('span')\n                    span_elem.style = \"font-size:0.8rem; margin-left:0.5rem\"\n                    span_elem.innerHTML = \"▼\"\n                    th.appendChild(span_elem)\n                    th.classList.add('order-inactive')\n                }\n                th.addEventListener('click', (() => {\n                    document.querySelectorAll('th.order').forEach(elem => {\n                        elem.classList.remove('order-active')\n                        elem.classList.add('order-inactive')\n                    })\n                    th.classList.remove('order-inactive')\n                    th.classList.add('order-active')\n                    if (!this.asc) {\n                        th.querySelector('span').innerHTML = '▲'\n                    } else {\n                        th.querySelector('span').innerHTML = '▼'\n                    }\n                    const table = th.closest('table');\n                    Array.from(table.querySelectorAll('tbody:nth-child(n+2)'))\n                        .sort(comparer(Array.from(th.parentNode.children).indexOf(th), this.asc = !this.asc))\n                        .forEach(tr => table.appendChild(tr) );\n                }))\n            });\n        }\n\n        var record = {};\n        var count = 0;\n        function attendence(){\n            HTML = \"<tr><th class='order'>Scanner</th><th class='order'>Name</th><th class='order'>Timestamp</th><th>Assigned UID</th><th id='total_count'>Total: \" + count + \"</th></tr>\";\n            document.getElementById(\"table1\").innerHTML=HTML;\n        }\n        \n        var ws;\n        var wsUri = \"ws:\";\n        var loc = window.location;\n        console.log(loc);\n        if (loc.protocol === \"https:\") { wsUri = \"wss:\"; }\n        // This needs to point to the web socket in the Node-RED flow in this case it's ws/attendence\n        wsUri += \"//\" + loc.host + loc.pathname.replace(\"attendence\",\"ws/timestamp\");\n        function wsTimestampConnect() {\n            console.log(\"connect\",wsUri);\n            ws = new WebSocket(wsUri);\n            ws.onmessage = function(msg) {\n                var data = msg.data;\n                var scanner = data.split(\"#\")[0];\n                var name = data.split(\"#\")[1];\n                var timestamp = data.split(\"#\")[2];\n                if (document.getElementById(name) !== null){\n                    document.getElementById(name).children[0].innerHTML = scanner;\n                    document.getElementById(name).children[1].innerHTML = name;\n                    document.getElementById(name).children[2].innerHTML = timestamp;\n                } else {\n                    document.getElementById(\"table1\").innerHTML += \"<tr id='\" + name + \"'><td>\" + scanner + \"</td><td>\" + name + \"</td><td>\" + timestamp + \"</td><td></td></tr>\";\n                    count += 1;\n                    document.getElementById(\"total_count\").innerHTML = \"Total: \" + count;\n                }\n                sortTable();\n            }\n            ws.onopen = function() {\n                console.log(\"connected\");\n            }\n            ws.onclose = function() {\n                // in case of lost connection tries to reconnect every 3 secs\n                setTimeout(wsTimestampConnect,3000);\n            }\n        }\n        var wsL;\n        var wsLUri = \"ws:\";\n        var locL = window.location;\n        console.log(locL);\n        if (locL.protocol === \"https:\") { wsLUri = \"wss:\"; }\n        // This needs to point to the web socket in the Node-RED flow in this case it's ws/attendence\n        wsLUri += \"//\" + locL.host + locL.pathname.replace(\"attendence\",\"ws/uid\");\n        function wsUIDConnect() {\n            console.log(\"connect\",wsLUri);\n            ws = new WebSocket(wsLUri);\n            ws.onmessage = function(msg) {\n                var data = msg.data;\n                var name = data.split(\"#\")[1];\n                var uid = data.split(\"#\")[2];\n                document.getElementById(name).children[3].innerHTML = uid; // gaurantee to have registered\n            }\n            ws.onopen = function() {\n                console.log(\"connected\");\n            }\n            ws.onclose = function() {\n                // in case of lost connection tries to reconnect every 3 secs\n                setTimeout(wsUIDConnect,3000);\n            }\n        }\n        \n    </script>\n        <style>\n            table {\n              font-family: arial, sans-serif;\n              border-collapse: collapse;\n              width: 100%;\n            }\n            \n            td, th {\n              border: 1px solid #dddddd;\n              text-align: left;\n              padding: 8px;\n            }\n            \n            tr:nth-child(even) {\n              background-color: #dddddd;\n            }\n        </style>\n    </head>\n    <body onload=\"wsTimestampConnect();wsUIDConnect();attendence()\" onunload=\"ws.disconnect();\">\n        <div class=\"landinMain\" style=\"line-height:200px\">\n            <div class=\"header\" style=\"height:200px; vertical-align:middle\">\n                <h2 style=\"font-size:50px; margin:0px; text-align:center\" ><a href=\"/simple\" style=\"color:white\">Smart Attendence</a></h2>\n            </div>\n        </div>\n        <table>\n            <tr><th style=\"text-align: center; border: none;\"><h1>Check-In</h1></th></tr>\n            <tbody>\n                <tr>\n                    <td style=\"vertical-align: top; border: none\">\n                        <table id=\"table1\"></table>\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n    </body>\n</html>\n",
        "x": 370,
        "y": 300,
        "wires": [
            [
                "829ea06f.fa0fc"
            ]
        ]
    },
